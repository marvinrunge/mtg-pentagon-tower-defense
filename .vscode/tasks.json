{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Validate Project",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\validate_godot.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Meshy: Preview Request (No Credits)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\meshy_asset.ps1",
        "-Name",
        "${input:meshyAssetName}",
        "-Prompt",
        "${input:meshyPrompt}",
        "-TexturePrompt",
        "${input:meshyTexturePrompt}",
        "-DryRun"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "meshyAssetName",
      "type": "promptString",
      "description": "Asset name (letters, numbers, hyphen, underscore)",
      "default": "arcane-tower"
    },
    {
      "id": "meshyPrompt",
      "type": "promptString",
      "description": "Meshy geometry prompt",
      "default": "Low-poly fantasy defense tower with a strong readable silhouette and no ground plane"
    },
    {
      "id": "meshyTexturePrompt",
      "type": "promptString",
      "description": "Material and color direction",
      "default": "Game-ready PBR, weathered stone, restrained magical accents"
    }
  ]
}
