static func get_visual_scene(color_identity: String) -> PackedScene:
	if not VISUAL_SCENES.has(color_identity):
		return null
	var path: String = VISUAL_SCENES[color_identity]
	if not ResourceLoader.exists(path):
		return null
	return load(path) as PackedScene


static func get_model_scale(color_identity: String, fallback: float) -> float:
	return MODEL_SCALES.get(color_identity, fallback)


## Every special this colour's boss has, across all three phases. EnemyBase filters them by
## phase and orders them by priority; see the SPECIALS comment.
static func get_specials(color_identity: String) -> Array:
	return SPECIALS.get(color_identity, [])


static func get_phase_config(color_identity: String) -> Dictionary:
	return PHASES.get(color_identity, {})


## Whether `config` is in play during `phase`.
static func special_in_phase(config: Dictionary, phase: int) -> bool:
	return (config.get("phases", [1, 2, 3]) as Array).has(phase)
